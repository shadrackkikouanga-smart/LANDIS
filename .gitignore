# =========================
# LANDIS - Git Ignore
# =========================

# Dépendances Node.js
node_modules/
frontend/node_modules/
backend/node_modules/

# Variables d'environnement
.env
.env.local
.env.development
.env.production
.env.test

frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production

backend/.env
backend/.env.local
backend/.env.development
backend/.env.production

# Next.js
frontend/.next/
frontend/out/

# NestJS / build
backend/dist/
backend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# Système
.DS_Store
Thumbs.db

# Éditeurs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/

# Fichiers temporaires
*.tmp
*.temp

# Documents générés localement
backend/documents/contrats/

# Fichiers de recherche temporaires
backend/recherche-partie*.txt